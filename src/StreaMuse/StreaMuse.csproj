<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 19041 is what projects Windows.Media.Control (SMTC) into C#. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreaMuse</RootNamespace>
    <AssemblyName>StreaMuse</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- NAudio process loopback ships only in 3.0 preview; see CLAUDE.md before changing. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0-preview.20" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- Beat detection for the built-in DJ mixer. A managed rewrite of SoundTouch, so nothing native
         ships alongside it. LGPL-2.1: referenced unmodified and replaceable, which is what that
         licence asks of a caller. -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>

  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
