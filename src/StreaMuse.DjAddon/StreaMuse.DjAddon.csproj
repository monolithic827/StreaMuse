<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the host's TFM to reference its Windows-flavored contract types. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreaMuse.DjAddon</RootNamespace>
    <AssemblyName>StreaMuse.DjAddon</AssemblyName>
    <!-- A class library does not copy its package assemblies to the output folder by default, which
         is fine for something referenced by an app and wrong for a plugin: this DLL is carried to the
         plugins folder on its own, and its dependencies have to travel with it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beat detection and time-stretching. A managed rewrite of SoundTouch, so nothing native ships
         beside the plugin - see CLAUDE.md on why a native dependency would be awkward here. LGPL-2.1:
         referenced unmodified and replaceable, which is what that licence asks of a caller. -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: StreaMuse.dll must not be copied next to this DLL in the plugins folder. The
         addon runs inside the already-running StreaMuse.exe, whose assembly resolution falls back to
         the host's own loaded copy; a second copy here would be a distinct type identity and every
         IDjAddon cast in DjAddonHost would fail. -->
    <!-- ExcludeAssets="runtime" as well as Private="false": with CopyLocalLockFileAssemblies on, the
         host's own package assemblies (NAudio, SkiaSharp, WebView2) would otherwise flow through this
         reference into the output and get carried to the plugins folder, where at best they are noise
         and at worst a second copy of something the host has already loaded. -->
    <ProjectReference Include="..\StreaMuse\StreaMuse.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Same fix as the main project: WebView2 arrives transitively through the ProjectReference and
       adds its WPF assembly regardless, conflicting with the ref-pack WindowsBase. See CLAUDE.md. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
